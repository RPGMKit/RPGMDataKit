<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <!-- the submodule has its own project (referenced below): its files are not part of this one -->
      <Compile Remove="external\**" />
      <EmbeddedResource Remove="external\**" />
      <None Remove="external\**" />
      <!-- the tests have their own project -->
      <Compile Remove="tests\**" />
      <EmbeddedResource Remove="tests\**" />
      <None Remove="tests\**" />
      <!-- the pictures of maps have their own project (it needs an image library, which the data library does not) -->
      <Compile Remove="Imaging\**" />
      <EmbeddedResource Remove="Imaging\**" />
      <None Remove="Imaging\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="external\RubyMarshalCS\RubyMarshalCS\RubyMarshalCS.csproj" />
    </ItemGroup>

</Project>
