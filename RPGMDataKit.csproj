      <None Remove="external\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="external\RubyMarshalCS\RubyMarshalCS\RubyMarshalCS.csproj" />
    </ItemGroup>

</Project>
